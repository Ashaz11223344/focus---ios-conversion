<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_journal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/literata_bold"
            android:text="JOURNAL"
            android:textColor="#FC6E20"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:src="@android:color/transparent"
            android:background="#323232" />
    </LinearLayout>

    <!-- Latest Journal Content (Preview) -->
    <TextView
        android:id="@+id/widget_journal_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:fontFamily="@font/literata_regular"
        android:ellipsize="end"
        android:maxLines="8"
        android:text="Start writing your journal"
        android:textColor="#FFE7D0"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2" />

</RelativeLayout>
