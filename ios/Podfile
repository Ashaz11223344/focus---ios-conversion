platform :ios, '14.0'

target 'Focus' do
  use_frameworks!

  # KMP shared framework (automatically generated)
  # pod 'shared', :path => '../shared/build/XCFrameworks/shared/release/shared.podspec'

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)', '-lsqlite3']
      end
    end
  end
end
